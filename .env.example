# Copy this file to .env and fill in real values. Never commit .env itself
# (it's gitignored) and never put real credentials in this file.

# Django
DJANGO_SECRET_KEY=changeme-generate-a-real-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000

# Database (Neon Postgres) — sslmode=require is mandatory, not optional.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Object storage (Cloudflare R2, S3-compatible)
AWS_ACCESS_KEY_ID=changeme-r2-access-key-id
AWS_SECRET_ACCESS_KEY=changeme-r2-secret-access-key
AWS_STORAGE_BUCKET_NAME=changeme-bucket-name
AWS_S3_ENDPOINT_URL=https://changeme.r2.cloudflarestorage.com

# Email (Resend, via django-anymail). RESEND_API_KEY is required when
# DJANGO_DEBUG=False and optional locally: with DJANGO_DEBUG=True the console
# email backend is the default, so an invite prints to the runserver terminal
# (set-password link included) instead of calling Resend. Uncomment below to
# send for real from a dev machine that does hold a valid key. Ignored when
# DJANGO_DEBUG=False, where the Resend backend is always used.
# DJANGO_EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=changeme-resend-api-key
CLUB_EMAIL_FROM=changeme@example.com

# Spotify (Client Credentials Flow, public playlist import). Optional: when
# unset the import reports itself unavailable rather than raising.
SPOTIFY_CLIENT_ID=changeme-spotify-client-id
SPOTIFY_CLIENT_SECRET=changeme-spotify-client-secret
