# Secrets / local config — never commit real credentials or env values.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# The tech stack is settled (issue #3, issue #318): npm dependencies and the
# Vite build output, never committed.
node_modules/
/frontend/dist/

# collectstatic output; regenerated by the deploy build (build.sh).
staticfiles/
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
npm-debug.log*
